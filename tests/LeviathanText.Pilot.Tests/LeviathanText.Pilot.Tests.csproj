<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/ExperimentOutput.cs" Link="Shared/ExperimentOutput.cs" />
    <Compile Include="../Shared/TestCapabilityAttributes.cs" Link="Shared/TestCapabilityAttributes.cs" />
    <Compile Include="../Shared/SkippableCapabilityAttributes.cs" Link="Shared/SkippableCapabilityAttributes.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" Condition="'$(LEVIATHANTEXT_RUN_CORPUS)' == '1'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LeviathanText.Formats\LeviathanText.Formats.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Imaging\LeviathanText.Imaging.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Training\LeviathanText.Training.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Application\LeviathanText.Application.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Cli\LeviathanText.Cli.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Layout\LeviathanText.Layout.csproj" />
    <ProjectReference Include="..\..\src\LeviathanText.Evaluation\LeviathanText.Evaluation.csproj" />
  </ItemGroup>

</Project>