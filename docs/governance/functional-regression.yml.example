# Inactive example: maintainer review/activation belongs to github-enforcement.md.
# Official action tag refs checked 2026-11-05; immutable hashes pin this example.
name: Leviathan engineering
'on':
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: engineering-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  functional-regression:
    name: Leviathan / functional-regression
    runs-on: macos-15
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - name: Require the native pilot architecture
        run: test "$(uname -m)" = arm64
      - uses: actions/setup-dotnet@26b0ec14cb23fa6904739307f278c14f94c95bf1 # v5
        with:
          dotnet-version: 10.0.x
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: 22
      - name: Record runtimes
        run: |
          dotnet --info
          node --version
          npm --version
          python3 --version
      - name: Restore and verify selected C# engineering suites
        run: |
          dotnet restore LeviathanText.slnx
          scripts/verify-engineering.sh --results "$RUNNER_TEMP/engineering-receipts"
      - name: Build and verify Angular
        working-directory: web
        run: |
          npm ci
          npm run verify:consumers
          npm run build
          npm test -- --watch=false --browsers=ChromeHeadless
      - name: Verify development scripts
        run: python3 -B -m unittest discover -s scripts/tests
      - name: Preserve engineering receipts
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: engineering-receipts
          path: ${{ runner.temp }}/engineering-receipts
          if-no-files-found: ignore
          retention-days: 14
